#!name=白云天气 · 会员解锁 (Surge)
#!desc=重写 RevenueCat 客户信息与自有后端会员字段，进程无感；不重打包 IPA
#!system=ios

[Script]
WC_Unlock = type=http-response,pattern=^https?://(api\.revenuecat\.com|api\.rc-backup\.com|untech\.cc)/,requires-body=1,max-size=2097152,script-path=https://raw.githubusercontent.com/TO8E/WhiteCloud-Surge/main/whitecloud_unlock.js,timeout=15

[MITM]
hostname = %APPEND% api.revenuecat.com, api.rc-backup.com, untech.cc, a.revenue.cat
